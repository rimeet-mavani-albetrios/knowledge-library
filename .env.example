# Copy this file to ".env" and fill in your own values. Never share or commit ".env".

# Free AI for summaries, categories and tags. Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Your owner password. Only someone with this password can add, edit or delete links.
# Leave it empty on your own computer to skip the login while you test.
ADMIN_PASSWORD=

# Your Neon database link (https://neon.com). Leave it empty on your computer:
# the app then uses a small built-in database stored in the .data folder.
DATABASE_URL=

# Optional: shown at the top of the website.
LIBRARY_TITLE=Knowledge Library

# Optional: the port on your computer (default 4747). Online hosts like Render set this for you.
# PORT=4747

# Optional: set to true so only you (after logging in) can see the library.
PRIVATE_LIBRARY=false

# Optional: use another OpenAI-compatible AI instead of Groq (for example Gemini's free plan).
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_API_KEY=
# AI_MODELS=gemini-2.5-flash

# Optional: a free GitHub token (no permissions needed) so the robot can read star counts
# for many repositories. Without it GitHub allows only 60 lookups per hour.
# Create one at https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=
