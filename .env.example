# Copy this file to ".env" and fill in your own values. Never share or commit ".env".

# Free AI for summaries, categories and tags. Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Your owner password. Only someone with this password can add, edit or delete links.
# Leave it empty on your own computer to skip the login while you test.
ADMIN_PASSWORD=

# Your Neon database link (https://neon.com). Leave it empty on your computer:
# the app then uses a small built-in database stored in the .data folder.
DATABASE_URL=

# Optional: shown at the top of the website.
LIBRARY_TITLE=Knowledge Library

# Optional: the port on your computer (default 4747). Online hosts like Render set this for you.
# PORT=4747

# Optional: set to true so only you (after logging in) can see the library.
PRIVATE_LIBRARY=false

# Optional: use another OpenAI-compatible AI instead of Groq (for example Gemini's free plan).
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_API_KEY=
# AI_MODELS=gemini-2.5-flash

# Optional: a free GitHub token (no permissions needed) so the robot can read star counts
# for many repositories. Without it GitHub allows only 60 lookups per hour.
# Create one at https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# Optional: set to off to stop the background website-facts checks (who runs it, app rating, trust grade…).
# Opening a link still collects its facts.
# FACTS_RUNNER=off

# Optional: "Popular in" (how popular each website is, and in which countries), from Cloudflare Radar.
# A free Cloudflare account → My Profile → API Tokens → Create Token → Custom token,
# with the permission Account → Radar → Read.
CLOUDFLARE_API_TOKEN=

# Optional: YouTube tutorials for each website, and Google's safety check (phishing, malware).
# A free Google Cloud project with "YouTube Data API v3" and "Safe Browsing API" turned on,
# and an API key restricted to those two. No billing account needed.
GOOGLE_API_KEY=

# Optional: turns on POST /api/cron/daily, the daily wake-up that checks prices and what's new.
# Use a long random text (for example from: openssl rand -hex 32). GitHub Actions sends the same text
# (repository secret CRON_SECRET, with LIBRARY_URL = your library's address). See .github/workflows/daily.yml.
CRON_SECRET=

# Optional: "Your library this week", an email every Monday morning with what changed on your links.
# Make a free account at https://resend.com, create an API key, and put it here.
# Without your own domain, Resend can only send to the email you signed up with, so use that address below.
RESEND_API_KEY=
WEEKLY_EMAIL_TO=
# Optional: your own sender, once you verified a domain in Resend.
# WEEKLY_EMAIL_FROM=Knowledge Library <library@yourdomain.com>
# Optional: the website's address for the buttons in the email. Render fills this in by itself.
# PUBLIC_URL=https://your-library.onrender.com
